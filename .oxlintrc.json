{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "vue",
    "import",
    "jsx-a11y",
    "typescript",
    "unicorn",
    "oxc",
    "promise",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-case-declarations": "error",
    "no-empty": "error",
    "no-fallthrough": "error",
    "no-prototype-builtins": "error",
    "no-redeclare": "error",
    "no-regex-spaces": "error",
    "no-undef": "error",
    "no-useless-assignment": "error",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }]
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "overrides": [
    {
      "files": ["apps/web/**"],
      "rules": {
        "no-undef": "off"
      }
    }
  ],
  "settings": {
    "react": {
      "version": "19.2"
    }
  },
  "ignorePatterns": [
    "**/.next/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/.vite/**",
    "**/.data/**",
    "**/dist/**",
    "**/next-env.d.ts"
  ]
}
