{
  "name": "bff",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -c development -e ../../.env -- nest start --watch",
    "build": "dotenv -c production -e ../../.env -- nest build",
    "start": "dotenv -c production -e ../../.env -- node dist/main",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@repo/env": "workspace:*",
    "dotenv-cli": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
