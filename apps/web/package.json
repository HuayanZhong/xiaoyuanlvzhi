{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -c development -e ../../.env -- nuxt dev --strictPort",
    "build": "dotenv -c production -e ../../.env -- nuxt build",
    "preview": "dotenv -c production -e ../../.env -- nuxt preview --strictPort",
    "postinstall": "nuxt prepare",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource/lxgw-wenkai": "5.3.0",
    "@repo/env": "workspace:*",
    "@supermousejs/core": "2.4.3",
    "@supermousejs/dot": "2.4.3",
    "@supermousejs/ring": "2.4.3",
    "lucide-vue-next": "^1.0.0",
    "motion-v": "^2.11.1",
    "nuxt": "4.6.3",
    "reka-ui": "^2.11.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.3.4",
    "@repo/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "dotenv-cli": "11.0.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
